@startuml 12-view-print-reports-activity
title عرض التقارير وطباعتها — UC10

skinparam defaultFontName Dubai
skinparam defaultFontSize 20
skinparam titleFontSize 26
skinparam defaultTextAlignment center
skinparam shadowing false
skinparam ArrowColor #526578
skinparam activity {
  BackgroundColor #F1F7F8
  BorderColor #526578
  FontColor #17354A
  DiamondBackgroundColor #FAF8F2
  DiamondBorderColor #9A8051
}

start
:يختار المستخدم تقييمًا محفوظًا\nويطلب عرض تقريره;
:التحقق من صلاحية الاطلاع\nعلى جميع المراجع المطلوبة;
if (الطلب مخول؟) then ([مخول])
  :استرجاع المحتوى المحفوظ\nوتثبيت مراجع التقييم وأوقات البيانات;
else ([else])
  :رفض الطلب دون كشف البيانات;
  stop
endif

:تجهيز النتائج والأدلة والقيود\nوالمقارنة والخطة عند طلبهما;
:حجب البيانات الحساسة\nوتسجيل مراجع التقرير ووقت إعداده;
if (المحتوى جاهز للعرض؟) then ([جاهز])
  :عرض المعاينة مع النطاق\nوالأحكام وحدود التغطية;
else ([else])
  :توضيح سبب التعذر\nدون ادعاء اكتمال التقرير;
  stop
endif

if (طلب المستخدم الطباعة؟) then ([طباعة])
  :إعادة التحقق من التفويض\nوتطابق المحتوى مع المعاينة;
  if (الطباعة مخولة والمحتوى مطابق؟) then ([مخول ومطابق])
    :تجهيز نسخة الطباعة وفتح الحوار\nليختار المستخدم الإتمام أو الإلغاء;
  else ([else])
    :منع الطلب غير المخول\nأو طلب معاينة محدثة عند تغير المحتوى;
  endif
else ([else])
endif
stop

legend bottom
  تصميم مستهدف • المستخدم هو المقيّم أو المراجع المخول.
  عرض التقرير لا يشغّل تقييمًا ولا يثبت طباعة فعلية.
  تفاصيل البدائل في وصف UC10.
endlegend
@enduml
